@model Sistema_de_inventario_y_ventas.Models.Producto
@{
    ViewData["Title"] = "Detalle del producto";
}

<h1>@Model.ProductoNombre</h1>

<dl class="row">
    <dt class="col-sm-2">Categoría</dt>
    <dd class="col-sm-10">@Model.NombreCategoria</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@(Model.Descripcion ?? "—")</dd>

    <dt class="col-sm-2">Precio unitario</dt>
    <dd class="col-sm-10">@Model.PrecioUnitario.ToString("C")</dd>

    <dt class="col-sm-2">Unidades</dt>
    <dd class="col-sm-10">@Model.Unidades</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>