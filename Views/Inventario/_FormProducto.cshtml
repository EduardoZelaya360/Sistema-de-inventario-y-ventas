
@model Sistema_de_inventario_y_ventas.Models.Producto

<form asp-action="Create" method="post" id="formProducto" novalidate>
    <div class="mb-3">
        <label class="form-label">Producto</label>
        <input asp-for="ProductoNombre" id="inputProducto" class="form-control" list="listaProductos" autocomplete="off" required />
        <datalist id="listaProductos">
            @foreach (var nombre in (List<string>)ViewBag.ProductosExistentes)
            {
                <option value="@nombre"></option>
            }
        </datalist>
        <div class="invalid-feedback">Por favor ingresa el nombre del producto.</div>
        <div id="alertaDuplicado" class="alert alert-warning mt-2 py-2 d-none">
            Ya existe un producto con ese nombre. Revisa la lista de inventario en vez de crear uno nuevo.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <select asp-for="NombreCategoria" id="selectCategoria" class="form-select" required>
            <option value="">-- Selecciona --</option>
            @foreach (var c in (List<Sistema_de_inventario_y_ventas.Models.Categoria>)ViewBag.Categorias)
            {
                <option value="@c.NombreCategoria">@c.NombreCategoria</option>
            }
        </select>
        <div class="invalid-feedback">Debes seleccionar una categoría obligatoriamente.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción <span class="text-muted small">(Opcional)</span></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Precio unitario</label>
        <input asp-for="PrecioUnitario" id="inputPrecio" class="form-control" type="number" step="0.01" min="0.01" required />
        <div class="invalid-feedback">El precio unitario debe ser mayor a 0.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Unidades</label>
        <input asp-for="Unidades" id="inputUnidades" class="form-control" type="number" min="1" required />
        <div class="invalid-feedback">Las unidades deben ser mayores a 0.</div>
    </div>

    <button type="submit" class="btn btn-primary" id="btnGuardar">Guardar</button>
</form>

<script>
    (function () {
        const productosExistentes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((List<string>)ViewBag.ProductosExistentes).Select(p => p.ToLower())
        ));

        const inputProducto = document.getElementById('inputProducto');
        const selectCategoria = document.getElementById('selectCategoria');
        const inputPrecio = document.getElementById('inputPrecio');
        const inputUnidades = document.getElementById('inputUnidades');
        
        const alertaDuplicado = document.getElementById('alertaDuplicado');
        const btnGuardar = document.getElementById('btnGuardar');
        const formProducto = document.getElementById('formProducto');

        function validarCampo(input, condicionValida) {
            if (condicionValida) {
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
                return true;
            } else {
                input.classList.remove('is-valid');
                input.classList.add('is-invalid');
                return false;
            }
        }

        function validarFormularioCompleto() {
            // 1. Validar nombre y duplicado (No vacío y no repetido)
            const valProducto = inputProducto.value.trim().toLowerCase();
            const esDuplicado = valProducto !== '' && productosExistentes.includes(valProducto);
            alertaDuplicado.classList.toggle('d-none', !esDuplicado);
            
            const productoValido = validarCampo(inputProducto, valProducto !== '' && !esDuplicado);

            // 2. Validar categoría (Obligatoria, no vacía)
            const categoriaValida = validarCampo(selectCategoria, selectCategoria.value !== '');

            // 3. Validar precio (Estrictamente mayor a 0)
            const precioValido = validarCampo(inputPrecio, inputPrecio.value !== '' && parseFloat(inputPrecio.value) > 0);

            // 4. Validar unidades (Estrictamente mayor a 0)
            const unidadesValidas = validarCampo(inputUnidades, inputUnidades.value !== '' && parseInt(inputUnidades.value) > 0);

            const todoValido = productoValido && categoriaValida && precioValido && unidadesValidas && !esDuplicado;
            btnGuardar.disabled = esDuplicado;

            return todoValido;
        }

        // Eventos dinámicos en tiempo real (Rojo / Verde instantáneo al escribir o corregir)
        [inputProducto, selectCategoria, inputPrecio, inputUnidades].forEach(element => {
            element.addEventListener('input', validarFormularioCompleto);
            element.addEventListener('change', validarFormularioCompleto);
        });

        formProducto.addEventListener('submit', function (e) {
            if (!validarFormularioCompleto()) {
                e.preventDefault();
                e.stopPropagation();
            }
        });
    })();
</script>
