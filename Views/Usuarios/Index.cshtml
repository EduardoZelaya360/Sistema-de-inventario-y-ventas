@model IEnumerable<Sistema_de_inventario_y_ventas.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>Gestión de Usuarios</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
    </a>
</div>

<div class="mb-3">
    <input type="text" id="inputBusquedaUsuarios" class="form-control" placeholder="Buscar por nombre, correo o rol...">
</div>

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tablaUsuarios">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-nombre="@item.Nombre.ToLower()" data-email="@item.Email.ToLower()" data-rol="@item.Rol.ToLower()">
                        <td class="fw-semibold">@item.Nombre</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.Rol == "Administrador" ? "bg-danger" : "bg-success")">
                                @item.Rol
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este usuario?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const inputBusquedaUsuarios = document.getElementById('inputBusquedaUsuarios');
        const filasUsuarios = document.querySelectorAll('#tablaUsuarios tbody tr');

        inputBusquedaUsuarios.addEventListener('input', () => {
            const texto = inputBusquedaUsuarios.value.trim().toLowerCase();

            filasUsuarios.forEach(fila => {
                const nombre = fila.dataset.nombre || '';
                const email = fila.dataset.email || '';
                const rol = fila.dataset.rol || '';
                const coincide = nombre.includes(texto) || email.includes(texto) || rol.includes(texto);

                fila.classList.toggle('d-none', !coincide);
            });
        });
    </script>
}