@model Sistema_de_inventario_y_ventas.Models.DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
    var nombreUsuario = Context.Session.GetString("UsuarioNombre");
    var cambioPositivo = Model.PorcentajeCambioSemanal >= 0;
    var topCriticos = Model.ProductosStockBajo.Take(3).ToList();
}

<style>
    @@keyframes parpadeoAlerta {
        0%   { background-color: #f8d7da; border-color: #dc3545; }
        50%  { background-color: #fff3cd; border-color: #ffc107; }
        100% { background-color: #f8d7da; border-color: #dc3545; }
    }

    .card-alerta-critica {
        animation: parpadeoAlerta 1.8s infinite;
        border-width: 2px;
        border-style: solid;
    }

    /* Contenedor con altura fija para controlar el tamaño visual */
    .chart-container {
        position: relative;
        height: 220px;
        width: 100%;
    }
</style>

<div class="p-5 mb-4 bg-white rounded-4 shadow-sm border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-dark">
            Bienvenido a StockFlow@(nombreUsuario != null ? ", " + nombreUsuario : "")!
        </h1>
        <p class="col-md-8 fs-5 text-muted mt-2">
            Sistema de inventario y ventas.
        </p>
    </div>
</div>

@if (topCriticos.Any())
{
    <div class="row g-3 mb-3">
        @foreach (var p in topCriticos)
        {
            <div class="col-md-4">
                <div class="card card-alerta-critica rounded-4 h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-2 text-danger"></i>
                        <div>
                            <h6 class="fw-bold mb-1">@p.ProductoNombre</h6>
                            <p class="mb-0 small text-dark">
                                Solo quedan <strong>@p.Unidades</strong> unidad@(p.Unidades == 1 ? "" : "es")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- KPIs -->
<div class="row g-3 mb-3">
    <div class="col-md-2 col-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted small">Productos</h6>
                <p class="h3 fw-bold mb-0">@Model.TotalProductos</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted small">Categorías</h6>
                <p class="h3 fw-bold mb-0">@Model.TotalCategorias</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted small">Ventas hoy</h6>
                <p class="h3 fw-bold mb-0">@Model.VentasHoy</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted small">Ingresos hoy</h6>
                <p class="h3 fw-bold mb-0">L @Model.IngresosHoy.ToString("N2")</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h6 class="text-muted small">Ticket promedio</h6>
                <p class="h3 fw-bold mb-0">L @Model.TicketPromedio.ToString("N2")</p>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 h-100 @(cambioPositivo ? "border-success" : "border-danger") border-2">
            <div class="card-body">
                <h6 class="text-muted small">Vs. semana pasada</h6>
                <p class="h3 fw-bold mb-0 @(cambioPositivo ? "text-success" : "text-danger")">
                    @(cambioPositivo ? "▲" : "▼") @Math.Abs(Model.PorcentajeCambioSemanal)%
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos (1 por fila con altura controlada) -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><strong>Ingresos — últimos 7 días</strong></div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartIngresos"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><strong>Productos más vendidos</strong></div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartTopProductos"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><strong>Ventas por categoría</strong></div>
            <div class="card-body">
                <!-- Se centra y limita el ancho de la dona para que no se deforme -->
                <div class="chart-container mx-auto" style="max-width: 380px;">
                    <canvas id="chartVentasCategoria"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><strong>Capital invertido por categoría</strong></div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartValorInventario"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tablas -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><strong>Alertas de stock bajo</strong></div>
            <div class="card-body p-0">
                @if (!Model.ProductosStockBajo.Any())
                {
                    <p class="text-muted p-3 mb-0">No hay productos con stock bajo.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Producto</th><th>Unidades</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.ProductosStockBajo)
                            {
                                <tr class="table-danger"><td>@p.ProductoNombre</td><td>@p.Unidades</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><strong>Últimas ventas</strong></div>
            <div class="card-body p-0">
                @if (!Model.UltimasVentas.Any())
                {
                    <p class="text-muted p-3 mb-0">Aún no hay ventas registradas.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead><tr><th>Productos</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var v in Model.UltimasVentas)
                            {
                                <tr>
                                    <td>
                                        @foreach (var d in v.Detalles)
                                        {
                                            <div>@d.Producto <span class="text-muted">x@(d.Unidades)</span></div>
                                        }
                                    </td>
                                    <td>L @v.TotalAPagar.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const diasLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DiasLabels));
        const ingresosPorDia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IngresosPorDia));
        const productosTopLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductosTopLabels));
        const productosTopUnidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductosTopUnidades));
        const ventasCategoriaLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasCategoriaLabels));
        const ventasCategoriaMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasCategoriaMontos));
        const valorInventarioLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValorInventarioLabels));
        const valorInventarioMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValorInventarioMontos));

        new Chart(document.getElementById('chartIngresos'), {
            type: 'line',
            data: { labels: diasLabels, datasets: [{ label: 'Ingresos', data: ingresosPorDia, borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,0.1)', tension: 0.3, fill: true }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });

        new Chart(document.getElementById('chartTopProductos'), {
            type: 'bar',
            data: { labels: productosTopLabels, datasets: [{ label: 'Unidades vendidas', data: productosTopUnidades, backgroundColor: '#198754' }] },
            options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true } } }
        });

        new Chart(document.getElementById('chartVentasCategoria'), {
            type: 'doughnut',
            data: { labels: ventasCategoriaLabels, datasets: [{ data: ventasCategoriaMontos, backgroundColor: ['#0d6efd','#198754','#ffc107','#dc3545','#6f42c1','#20c997'] }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
        });

        new Chart(document.getElementById('chartValorInventario'), {
            type: 'bar',
            data: { labels: valorInventarioLabels, datasets: [{ label: 'Valor invertido', data: valorInventarioMontos, backgroundColor: '#6f42c1' }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });
    </script>
}